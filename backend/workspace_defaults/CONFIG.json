{
  "agent": {
    "model": "qwen-plus",
    "temperature": 0.7,
    "max_steps": 24,
    "graph_version": "0.1.0-mvp"
  },
  "mcp_servers": {},
  "tools": {
    "filesystem": true,
    "shell": {
      "enabled": true,
      "default_timeout": 60,
      "max_timeout": 300,
      "safety_mode": true,
      "workdir": ".",
      "auto_approve_patterns": [
        "git status",
        "git diff*",
        "git log*",
        "dir",
        "dir *",
        "ls",
        "ls *"
      ],
      "extra_env": {}
    },
    "memory": true,
    "calculator": true,
    "datetime": true,
    "web_search": false,
    "mcp": true,
    "tool_search": {
      "enabled": true,
      "hot_tools": [
        "read_file",
        "list_directory",
        "run_shell",
        "memory_grep",
        "memory_add",
        "memory_consolidate",
        "python_calculator",
        "get_current_time"
      ],
      "search_default_limit": 5,
      "max_search_limit": 20,
      "mcp_as_hot": false
    }
  },
  "middleware": {},
  "telemetry": {
    "langsmith_enabled": false,
    "sample_rate": 0.01
  },
  "context": {
    "max_tokens": 128000,
    "compress_threshold_ratio": 0.75,
    "bootstrap": {
      "single_file_max_chars": 20000,
      "total_max_chars": 150000
    },
    "tool_result_max_tokens": 4000,
    "tool_summary_max_chars": 500,
    "budget": {
      "bootstrap": 0.18,
      "skills": 0.04,
      "summary": 0.12,
      "recent_turns": 0.28,
      "tool_results": 0.25,
      "current_message": 0.05,
      "reserved": 0.08
    },
    "recent_turn_pairs": 5,
    "max_compression_attempts": 3
  }
}
