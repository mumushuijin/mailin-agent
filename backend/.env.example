# LLM (OpenAI-compatible API preferred; configure one or both)

# OpenAI / compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Alibaba DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Server
HOST=0.0.0.0
PORT=8000

# Web search (optional; falls back to DuckDuckGo when unset)
TAVILY_API_KEY=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mailin

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOG_FORMAT=json
