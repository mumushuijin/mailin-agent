              "user_char_limit": {
                "default": 1500,
                "title": "User Char Limit",
                "type": "integer"
              },
              "section_char_limit": {
                "default": 800,
                "title": "Section Char Limit",
                "type": "integer"
              },
              "consolidate_interval_hours": {
                "default": 24,
                "title": "Consolidate Interval Hours",
                "type": "integer"
              },
              "max_candidates_per_run": {
                "default": 20,
                "title": "Max Candidates Per Run",
                "type": "integer"
              },
              "arbiter_batch_by_section": {
                "default": true,
                "title": "Arbiter Batch By Section",
                "type": "boolean"
              },
              "empty_section_placeholder": {
                "default": "（空）",
                "title": "Empty Section Placeholder",
                "type": "string"
              },
              "misc_compact_every": {
                "default": 5,
                "title": "Misc Compact Every",
                "type": "integer"
              }
            },
            "title": "ContextHotMemoryModel",
            "type": "object"
          },
          "ContextMemoryModel": {
            "additionalProperties": true,
            "properties": {
              "daily_sediment_every_turns": {
                "default": 5,
                "title": "Daily Sediment Every Turns",
                "type": "integer"
              },
              "longterm_consolidate_interval_hours": {
                "default": 24,
