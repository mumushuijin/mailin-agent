                "type": "integer"
              },
              "total_max_chars": {
                "default": 150000,
                "title": "Total Max Chars",
                "type": "integer"
              }
            },
            "title": "ContextBootstrapModel",
            "type": "object"
          },
          "ContextBudgetModel": {
            "additionalProperties": true,
