{
  "schema_version": 1,
  "ordinary_modules": [
    "agent",
    "tools",
    "middleware",
    "skills",
    "telemetry",
    "context"
  ],
  "user_visible_modules": [
    "agent",
    "tools"
  ],
  "enums": {
    "enforcement_mode": [
      "audit",
      "enforce"
    ],
    "mcp_transport": [
      "stdio",
      "streamable-http",
      "sse"
    ]
  },
  "modules": {
    "agent": {
      "key": "agent",
      "display_name": "Agent",
      "defaults": {
        "model": "qwen-plus",
        "temperature": 0.7,
        "max_steps": 48,
        "graph_version": "0.1.0-mvp"
      },
      "json_schema": {
        "additionalProperties": true,
        "properties": {
          "model": {
            "default": "qwen-plus",
            "title": "Model",
            "type": "string"
          },
          "temperature": {
            "default": 0.7,
            "title": "Temperature",
            "type": "number"
          },
          "max_steps": {
            "default": 48,
            "title": "Max Steps",
            "type": "integer"
          },
          "graph_version": {
            "default": "0.1.0-mvp",
            "title": "Graph Version",
            "type": "string"
          }
        },
        "title": "AgentModule",
        "type": "object"
      }
    },
    "tools": {
      "key": "tools",
      "display_name": "工具",
      "defaults": {
        "enforcement_mode": "enforce",
        "filesystem": true,
        "shell": true,
        "memory": true,
        "session": true,
        "skills": true,
        "calculator": true,
        "datetime": true,
        "web_search": false,
        "mcp": true,
        "tool_search": true
      },
      "json_schema": {
        "$defs": {
          "FilesystemPackageModel": {
            "additionalProperties": true,
            "properties": {
              "enabled": {
                "default": true,
                "title": "Enabled",
                "type": "boolean"
              },
              "snapshots": {
                "$ref": "#/$defs/SnapshotConfigModel"
              }
            },
            "title": "FilesystemPackageModel",
            "type": "object"
          },
          "ShellCommandPolicyModel": {
            "additionalProperties": true,
            "properties": {
              "executable": {
                "title": "Executable",
                "type": "string"
              },
              "args_prefix": {
                "items": {
                  "type": "string"
                },
                "title": "Args Prefix",
                "type": "array"
              },
              "allowed_roots": {
                "items": {
                  "type": "string"
                },
                "title": "Allowed Roots",
                "type": "array"
              },
              "capabilities": {
                "items": {
                  "type": "string"
                },
                "title": "Capabilities",
                "type": "array"
              }
            },
            "required": [
              "executable"
            ],
            "title": "ShellCommandPolicyModel",
            "type": "object"
          },
          "ShellPackageModel": {
            "additionalProperties": true,
            "properties": {
              "enabled": {
                "default": true,
                "title": "Enabled",
                "type": "boolean"
              },
              "default_timeout": {
                "default": 60,
                "title": "Default Timeout",
                "type": "integer"
              },
              "max_timeout": {
                "default": 300,
                "title": "Max Timeout",
                "type": "integer"
              },
              "safety_mode": {
                "default": true,
                "title": "Safety Mode",
                "type": "boolean"
              },
              "workdir": {
                "default": ".",
                "title": "Workdir",
                "type": "string"
              },
              "auto_approve_patterns": {
                "items": {
                  "type": "string"
                },
                "title": "Auto Approve Patterns",
                "type": "array"
              },
              "policy": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ShellPolicyModel"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "extra_env": {
                "additionalProperties": {
                  "type": "string"
                },
                "title": "Extra Env",
                "type": "object"
              }
            },
            "title": "ShellPackageModel",
            "type": "object"
          },
          "ShellPolicyModel": {
            "additionalProperties": true,
            "properties": {
              "allowed_roots": {
                "items": {
                  "type": "string"
                },
                "title": "Allowed Roots",
                "type": "array"
              },
              "capabilities": {
                "items": {
                  "type": "string"
                },
                "title": "Capabilities",
                "type": "array"
              },
              "commands": {
                "items": {
                  "$ref": "#/$defs/ShellCommandPolicyModel"
                },
                "title": "Commands",
                "type": "array"
              }
            },
            "title": "ShellPolicyModel",
            "type": "object"
          },
          "SnapshotConfigModel": {
            "additionalProperties": true,
            "properties": {
              "enabled": {
                "default": true,
                "title": "Enabled",
                "type": "boolean"
              },
              "retention": {
                "$ref": "#/$defs/SnapshotRetentionModel"
              }
            },
            "title": "SnapshotConfigModel",
            "type": "object"
          },
          "SnapshotRetentionModel": {
            "additionalProperties": true,
            "properties": {
              "max_count": {
                "default": 50,
                "title": "Max Count",
                "type": "integer"
              },
              "max_age_seconds": {
                "default": 604800,
                "title": "Max Age Seconds",
                "type": "integer"
              },
              "max_total_bytes": {
                "default": 209715200,
                "title": "Max Total Bytes",
                "type": "integer"
              }
            },
            "title": "SnapshotRetentionModel",
            "type": "object"
          },
          "ToolSearchPackageModel": {
            "additionalProperties": true,
            "properties": {
              "enabled": {
                "default": true,
                "title": "Enabled",
                "type": "boolean"
              },
              "hot_tools": {
                "items": {
                  "type": "string"
                },
                "title": "Hot Tools",
                "type": "array"
              },
              "search_default_limit": {
                "default": 5,
                "title": "Search Default Limit",
                "type": "integer"
              },
              "max_search_limit": {
                "default": 20,
                "title": "Max Search Limit",
                "type": "integer"
              },
              "mcp_as_hot": {
                "default": false,
                "title": "Mcp As Hot",
                "type": "boolean"
              }
            },
            "title": "ToolSearchPackageModel",
            "type": "object"
          }
        },
        "additionalProperties": true,
        "properties": {
          "enforcement_mode": {
            "default": "enforce",
            "enum": [
              "audit",
              "enforce"
            ],
            "title": "Enforcement Mode",
            "type": "string"
          },
          "filesystem": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/FilesystemPackageModel"
              }
            ],
            "default": true,
            "title": "Filesystem"
          },
          "shell": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/ShellPackageModel"
              }
            ],
            "default": true,
            "title": "Shell"
          },
          "memory": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "default": true,
            "title": "Memory"
          },
          "session": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "default": true,
            "title": "Session"
          },
          "skills": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "default": true,
            "title": "Skills"
          },
          "calculator": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "default": true,
            "title": "Calculator"
          },
          "datetime": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "default": true,
            "title": "Datetime"
          },
          "web_search": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "default": false,
            "title": "Web Search"
          },
          "mcp": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "default": true,
            "title": "Mcp"
          },
          "tool_search": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/ToolSearchPackageModel"
              }
            ],
            "default": true,
            "title": "Tool Search"
          }
        },
        "title": "ToolsModule",
        "type": "object"
      }
    },
    "middleware": {
      "key": "middleware",
      "display_name": "中间件",
      "defaults": {},
      "json_schema": {
        "additionalProperties": true,
        "description": "占位模块：当前运行时未消费，保留对象形状供后续扩展。",
        "properties": {},
        "title": "MiddlewareModule",
        "type": "object"
      }
    },
    "skills": {
      "key": "skills",
      "display_name": "技能",
      "defaults": {
        "global_roots": [
          "skills"
        ],
        "project_enabled": true,
        "catalog_max_items": 80,
        "catalog_max_chars": 12000,
        "cache_ttl_seconds": 5,
        "disabled": []
      },
      "json_schema": {
        "additionalProperties": true,
        "properties": {
          "global_roots": {
            "items": {
              "type": "string"
            },
            "title": "Global Roots",
            "type": "array"
          },
          "project_enabled": {
            "default": true,
            "title": "Project Enabled",
            "type": "boolean"
          },
          "catalog_max_items": {
            "default": 80,
            "title": "Catalog Max Items",
            "type": "integer"
          },
          "catalog_max_chars": {
            "default": 12000,
            "title": "Catalog Max Chars",
            "type": "integer"
          },
          "cache_ttl_seconds": {
            "default": 5,
            "title": "Cache Ttl Seconds",
            "type": "integer"
          },
          "disabled": {
            "items": {
              "type": "string"
            },
            "title": "Disabled",
            "type": "array"
          }
        },
        "title": "SkillsModule",
        "type": "object"
      }
