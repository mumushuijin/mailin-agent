        "budget": {
          "bootstrap": 0.18,
          "skills": 0.04,
          "summary": 0.12,
          "recent_turns": 0.28,
          "tool_results": 0.25,
          "current_message": 0.05,
          "reserved": 0.08
        },
        "recent_turn_pairs": 5,
        "recent_tail_max_tokens": 20000,
        "summary_max_chars": 3000,
        "summary_chunk_max_chars": 12000,
        "max_compression_attempts": 3,
