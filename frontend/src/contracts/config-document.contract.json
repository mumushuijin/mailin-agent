            "type": "object"
          }
        },
        "additionalProperties": true,
        "properties": {
          "max_tokens": {
            "default": 128000,
            "title": "Max Tokens",
            "type": "integer"
          },
          "compress_threshold_ratio": {
            "default": 0.75,
            "title": "Compress Threshold Ratio",
            "type": "number"
          },
          "bootstrap": {
            "$ref": "#/$defs/ContextBootstrapModel"
          },
          "tool_result_max_tokens": {
            "default": 4000,
            "title": "Tool Result Max Tokens",
            "type": "integer"
