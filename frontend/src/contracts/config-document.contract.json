          "recent_turn_pairs": {
            "default": 5,
            "title": "Recent Turn Pairs",
            "type": "integer"
          },
          "recent_tail_max_tokens": {
            "default": 20000,
            "title": "Recent Tail Max Tokens",
            "type": "integer"
          },
          "summary_max_chars": {
            "default": 3000,
            "title": "Summary Max Chars",
            "type": "integer"
          },
          "summary_chunk_max_chars": {
            "default": 12000,
            "title": "Summary Chunk Max Chars",
            "type": "integer"
          },
          "max_compression_attempts": {
